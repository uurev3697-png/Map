# OpenRouteService — https://openrouteservice.org/dev/#/signup
# Если не указан, используются публичные серверы OSRM (routing.openstreetmap.de)
VITE_ORS_API_KEY=

# Google Maps JavaScript API — https://console.cloud.google.com/google/maps-apis
# Если не указан, слой «Google» скрыт
VITE_GOOGLE_MAPS_API_KEY=
# (необязательно) Map ID для векторных карт Google
VITE_GOOGLE_MAPS_MAP_ID=
